#!/bin/sh
# Builds and tests on Arch Linux in a container, from any machine with Docker. Compiling under
# emulation is slow, so the Cargo caches live in a named volume that survives between runs. Jobs are
# limited because linking GPUI under emulation with a default Docker memory limit can run out.
#   script/linux-check            build and test
#   script/linux-check bundle     the Linux installer archive, into target/dist
#   script/linux-check shell      a shell in the same environment
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
command=${1:-test}

docker volume create gleipnir-linux-cache > /dev/null
case "$command" in
    shell) inner='exec bash' ;;
    bundle) inner='script/bundle' ;;
    test) inner='cargo build --workspace && cargo test --workspace' ;;
    *) echo "unknown command: $command" >&2; exit 2 ;;
esac

docker run --rm -i --platform linux/amd64 \
    -v "$root:/work" -w /work \
    -v gleipnir-linux-cache:/cache \
    -e CARGO_HOME=/cache/cargo -e RUSTUP_HOME=/cache/rustup -e CARGO_TARGET_DIR=/cache/target \
    -e CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-6}" \
    archlinux:latest bash -c "
        set -eu
        # pacman's sandbox needs seccomp features that x86_64 emulation doesn't provide.
        sed -i '/^\[options\]/a DisableSandbox' /etc/pacman.conf
        script/linux-deps > /dev/null
        if [ ! -x /cache/cargo/bin/cargo ]; then
            curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal > /dev/null
        fi
        export PATH=/cache/cargo/bin:\$PATH
        $inner
    "
