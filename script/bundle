#!/bin/sh
# Builds Gleipnir for release and packs an installer for this platform into target/dist:
#   macOS   Gleipnir-<version>-macos-<arch>.dmg: an installer window with Gleipnir and an
#           Applications shortcut to drag it onto
#   Linux   gleipnir-<version>-linux-<arch>.tar.gz: the program, its launcher and icons, and
#           install.sh, which puts them in ~/.local
# Each comes with a .sha256 file.
#
# macOS signing: ad hoc unless APPLE_SIGNING_IDENTITY names a Developer ID certificate in the
# keychain. With that, APPLE_ID, APPLE_TEAM_ID and APPLE_APP_PASSWORD (an app-specific password)
# also notarize the disk image, so it opens without Gatekeeper's warning.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

version=$(awk -F'"' '/^\[workspace\.package\]/ { inside = 1 } inside && /^version/ { print $2; exit }' Cargo.toml)
[ -n "$version" ] || { echo "no version in Cargo.toml's [workspace.package]" >&2; exit 1; }
# Releasing a tag: it has to say the same version as the code.
if [ "${GITHUB_REF_TYPE:-}" = tag ] && [ "${GITHUB_REF_NAME#v}" != "$version" ]; then
    echo "tag $GITHUB_REF_NAME doesn't match version $version in Cargo.toml" >&2
    exit 1
fi
arch=$(uname -m)
case "$arch" in aarch64) arch=arm64 ;; esac

# Where cargo builds, which script/linux-check moves elsewhere.
built=${CARGO_TARGET_DIR:-target}/release/gleipnir
dist=target/dist
rm -rf "$dist"
mkdir -p "$dist"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

checksum() {
    if command -v sha256sum >/dev/null 2>&1; then
        (cd "$dist" && sha256sum "$1" > "$1.sha256")
    else
        (cd "$dist" && shasum -a 256 "$1" > "$1.sha256")
    fi
}

case "$(uname)" in
Darwin)
    export MACOSX_DEPLOYMENT_TARGET=11.0
    cargo build --release --locked -p gleipnir

    app="$dist/Gleipnir.app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
    cp "$built" "$app/Contents/MacOS/gleipnir"
    build=$(git rev-list --count HEAD 2>/dev/null || echo 1)
    sed -e "s/@VERSION@/$version/" -e "s/@BUILD@/$build/" packaging/macos/Info.plist \
        > "$app/Contents/Info.plist"
    plutil -lint "$app/Contents/Info.plist" >/dev/null

    iconset="$work/Gleipnir.iconset"
    mkdir -p "$iconset"
    for size in 16 32 128 256 512; do
        sips -z "$size" "$size" packaging/icon/gleipnir-1024.png \
            --out "$iconset/icon_${size}x${size}.png" >/dev/null
        double=$((size * 2))
        sips -z "$double" "$double" packaging/icon/gleipnir-1024.png \
            --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
    done
    iconutil -c icns "$iconset" -o "$app/Contents/Resources/Gleipnir.icns"

    identity=${APPLE_SIGNING_IDENTITY:-}
    if [ -n "$identity" ]; then
        codesign --force --options runtime --timestamp --sign "$identity" "$app"
    else
        echo "Signing ad hoc: set APPLE_SIGNING_IDENTITY to sign with a Developer ID."
        codesign --force --sign - "$app"
    fi
    codesign --verify --strict "$app"

    # The installer window, laid out by dmgbuild, which writes Finder's settings itself rather
    # than driving Finder, so it works on build machines too. It's kept in a venv under target.
    venv=target/dmg-venv
    if [ ! -x "$venv/bin/dmgbuild" ]; then
        python3 -m venv "$venv"
        "$venv/bin/pip" install -q --disable-pip-version-check "dmgbuild==1.6.7"
    fi
    image="Gleipnir-$version-macos-$arch.dmg"
    "$venv/bin/dmgbuild" -s packaging/macos/dmg.py \
        -D app="$app" \
        -D volume_icon="$app/Contents/Resources/Gleipnir.icns" \
        -D settings_dir="$root/packaging/macos" \
        "Gleipnir $version" "$dist/$image"
    if [ -n "$identity" ]; then
        codesign --sign "$identity" --timestamp "$dist/$image"
        if [ -n "${APPLE_ID:-}" ] && [ -n "${APPLE_TEAM_ID:-}" ] && [ -n "${APPLE_APP_PASSWORD:-}" ]; then
            xcrun notarytool submit "$dist/$image" --apple-id "$APPLE_ID" \
                --team-id "$APPLE_TEAM_ID" --password "$APPLE_APP_PASSWORD" --wait
            xcrun stapler staple "$dist/$image"
        fi
    fi
    checksum "$image"
    echo "Built $dist/$image"
    ;;
Linux)
    cargo build --release --locked -p gleipnir

    name="gleipnir-$version-linux-$arch"
    stage="$work/$name"
    install -Dm755 "$built" "$stage/bin/gleipnir"
    install -Dm644 packaging/linux/gleipnir.desktop "$stage/share/applications/gleipnir.desktop"
    install -Dm644 packaging/icon/gleipnir.svg "$stage/share/icons/hicolor/scalable/apps/gleipnir.svg"
    for size in 128 256 512; do
        install -Dm644 "packaging/icon/gleipnir-$size.png" \
            "$stage/share/icons/hicolor/${size}x${size}/apps/gleipnir.png"
    done
    install -Dm755 packaging/linux/install.sh "$stage/install.sh"
    install -Dm644 LICENSE "$stage/LICENSE"
    tar -C "$work" -czf "$dist/$name.tar.gz" "$name"
    checksum "$name.tar.gz"
    echo "Built $dist/$name.tar.gz"
    ;;
*)
    echo "no installer for $(uname) yet" >&2
    exit 1
    ;;
esac
