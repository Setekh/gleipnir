#!/bin/sh
# Runs the end-to-end scripts against the real application. Needs a display.
#   script/e2e              all scripts, in the dev profile
#   script/e2e perf         one script
#   PROFILE=release script/e2e perf
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
profile=${PROFILE:-dev}
shots=${SHOTS:-$root/target/e2e-shots}
mkdir -p "$shots"

flag=""
out=debug
if [ "$profile" = release ]; then flag="--release"; out=release; fi

# Screenshots need GPUI's test support, which only works where the renderer can read frames back.
features=""
if [ "$(uname)" = Darwin ]; then features="--features capture"; fi
# shellcheck disable=SC2086
cargo build -p gleipnir $flag $features

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

make_fixtures() {
    dir=$1
    mkdir -p "$dir"
    printf 'fn main() {\n    println!("hello");\n}\n' > "$dir/main.rs"
    printf 'count := 1\nnotCount := count\nprint(count)\n' > "$dir/rename.go"
    printf 'package main\n\nimport "core:fmt"\n\nPoint :: struct {\n\tx, y: f32,\n}\n\nmain :: proc() {\n\tcount := 3 // tabs align\n\tfor i in 0..<count {\n\t\tfmt.println("hello", i)\n\t}\n}\n' > "$dir/app.odin"
    printf 'interface User {\n  id: number;\n  name: string;\n}\n\nexport function greet(user: User): string {\n  return `hi ${user.name}`;\n}\n' > "$dir/app.ts"
    printf 'export const View = (p: { name: string }) => <div className="a">{p.name}</div>;\n' > "$dir/view.tsx"
    printf 'export function add(a, b) {\n  return a + b; // sum\n}\n' > "$dir/app.js"
    printf 'package main\n\nimport "fmt"\n\ntype Point struct {\n\tX, Y int\n}\n\nfunc main() {\n\tp := Point{1, 2}\n\tfmt.Println("hi", p.X)\n}\n' > "$dir/app.go"
    mkdir -p "$dir/src" "$dir/target/debug"
    printf 'pub fn lib() {}\n' > "$dir/src/lib.rs"
    printf 'pub fn util() {}\n' > "$dir/src/util.rs"
    printf 'target/\nbig.rs\n' > "$dir/.gitignore"
    git -C "$dir" init -q
    git -C "$dir" -c user.email=e2e@example.com -c user.name=e2e add .
    git -C "$dir" -c user.email=e2e@example.com -c user.name=e2e commit -q -m fixtures
    printf 'pub fn lib() { changed() }\n' > "$dir/src/lib.rs"
    printf '// new\n' > "$dir/src/untracked.rs"
    python3 - "$dir/big.rs" <<'PY'
import sys
block = 'fn compute_value(input: &str, count: usize) -> Result<String, Error> {\n    let mut output = String::with_capacity(count);\n    for (index, ch) in input.chars().enumerate() {\n        if index % 2 == 0 { output.push(ch); }\n    }\n    Ok(format!("{output}: {count}"))\n}\n\n'
open(sys.argv[1], 'w').write(block * (100000 // block.count('\n')))
PY
}

# Real projects for real language servers: a crate, a Go module, a TypeScript project and Odin.
make_code_fixtures() {
    dir=$1
    mkdir -p "$dir/src" "$dir/web"
    printf '[package]\nname = "shapes_demo"\nversion = "0.1.0"\nedition = "2021"\n' > "$dir/Cargo.toml"
    printf 'mod shapes;\n\nfn main() {\n    let a = shapes::area(2.0);\n    let b = shapes::area(3.0);\n    println!("{a} {b}");\n}\n' > "$dir/src/main.rs"
    printf 'pub fn area(r: f64) -> f64 {\n    r * r\n}\n\npub trait Shape {\n    fn size(&self) -> f64;\n}\n\npub struct Square(pub f64);\n\nimpl Shape for Square {\n    fn size(&self) -> f64 {\n        self.0 * self.0\n    }\n}\n\npub struct Circle(pub f64);\n\nimpl Shape for Circle {\n    fn size(&self) -> f64 {\n        area(self.0) * 3.14\n    }\n}\n' > "$dir/src/shapes.rs"
    printf 'module demo\n\ngo 1.22\n' > "$dir/go.mod"
    printf 'package main\n\nimport "fmt"\n\nfunc double(n int) int {\n\treturn n * 2\n}\n\nfunc main() {\n\tfmt.Println(double(2), double(3))\n}\n' > "$dir/main.go"
    printf '{ "compilerOptions": { "strict": true, "target": "es2022", "module": "nodenext" } }\n' > "$dir/web/tsconfig.json"
    printf 'export interface User {\n  name: string;\n}\n\nexport function greet(user: User): string {\n  return "hi " + user.name;\n}\n' > "$dir/web/util.ts"
    printf 'import { greet } from "./util.js";\n\nconsole.log(greet({ name: "a" }));\n' > "$dir/web/app.ts"
    mkdir -p "$dir/odin"
    printf 'package demo\n\nimport "core:fmt"\n\ndouble :: proc(n: int) -> int {\n\treturn n * 2\n}\n\nmain :: proc() {\n\tfmt.println(double(2))\n}\n' > "$dir/odin/main.odin"
    mkdir -p "$dir/src/bin"
    printf 'fn main() {\n    let mut line = String::new();\n    std::io::stdin().read_line(&mut line).unwrap();\n    println!("hello {}", line.trim());\n}\n' > "$dir/src/bin/echo.rs"
    mkdir -p "$dir/js"
    printf 'function double(n) {\n  return n * 2;\n}\n\nmodule.exports = { double };\n' > "$dir/js/lib.js"
    printf 'const lib = require("./lib");\n\nconsole.log(lib.double(2));\n' > "$dir/js/app.js"
    mkdir -p "$dir/scripts"
    printf 'function total(values: number[]): number {\n  let sum = 0;\n  for (const v of values) {\n    sum += v;\n  }\n  return sum;\n}\n\nconsole.log("total", total([1, 2, 3]));\n' > "$dir/scripts/count.ts"
}

# `code` and `debug` drive real language servers and debuggers, so they only run when asked for.
# Tools that Gleipnir installs itself are looked for in E2E_TOOLS, a managed tools folder from an
# earlier install.
scripts=${*:-editing workspace search toolchains perf}
failed=0
for name in $scripts; do
    # The folder is named after the script, which is what shows as the project's name.
    dir="$work/$name/$name"
    if [ "$name" = code ] || [ "$name" = debug ]; then
        make_code_fixtures "$dir"
        if [ -n "${E2E_TOOLS:-}" ]; then
            mkdir -p "$work/$name/state"
            ln -s "$E2E_TOOLS" "$work/$name/state/tools"
        fi
    else
        make_fixtures "$dir"
    fi
    script="$work/$name.script"
    sed -e "s|{dir}|$dir|g" -e "s|{shots}|$shots|g" "$root/crates/gleipnir/e2e/$name.script" > "$script"
    echo "== $name"
    # Fresh state and config, so neither a saved layout nor a personal keymap changes the result.
    if GLEIPNIR_SCRIPT="$script" GLEIPNIR_STATE_DIR="$work/$name/state" \
        GLEIPNIR_CONFIG_DIR="$work/$name/config" "$root/target/$out/gleipnir" "$dir"; then :; else failed=1; fi
done
[ "$failed" = 0 ] && echo "all scripts passed"
exit "$failed"
